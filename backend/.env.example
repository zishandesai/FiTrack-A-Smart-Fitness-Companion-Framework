# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local or Atlas Free Tier <512MB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fittrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/fittrack

# JWT Authentication
JWT_SECRET=fittrack_super_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=30d

# Permanent Single Master Admin Identity
# (Cannot be deleted or modified; created on initial server seed)
ADMIN_NAME="Gym Administrator"
ADMIN_EMAIL="admin@fittrack.com"
ADMIN_PASSWORD="Admin@12345"

# Google Gemini API Key (For AI Nutrition Chatbot with Tools & Multimodal Form Vision)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
